{
  "name": "pgautopilot-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "precheck": "node scripts/dev-precheck.mjs --kill",
    "dev": "node scripts/dev-precheck.mjs --kill && turbo run dev",
    "build": "turbo run build",
    "start": "turbo run build && node apps/api/dist/index.cjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "security": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@pgautopilot/config": "workspace:^",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0"
  }
}