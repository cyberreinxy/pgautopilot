# ------------------------------------------------------------------
# Environment Variables Example
# ------------------------------------------------------------------
# Copy this file to `.env` and update the values for your environment.
# Never commit your real `.env` file or any secrets.
#
# This file contains placeholder values only and is safe to commit.
# ------------------------------------------------------------------

# PostgreSQL connection string.
# Format:
# postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# Server configuration.
PORT=3001
HOST=127.0.0.1

# Authentication token for accessing the dashboard.
# Leave empty to disable token authentication.
DASHBOARD_TOKEN=

# Allow starting in production without DASHBOARD_TOKEN.
# Only for controlled/non-exposed environments. Never true on a public endpoint.
ALLOW_NO_AUTH=false

# Maximum execution time (in milliseconds) for SQL statements.
PG_STATEMENT_TIMEOUT_MS=10000

# Directory used to store backups.
BACKUPS_DIR=./backups

# Directory used to store database snapshots (auto-created before migrations).
# Requires the `pg_dump` binary, or DOCKER_CONTAINER when PostgreSQL runs in Docker.
SNAPSHOTS_DIR=./snapshots

# Docker container name running PostgreSQL.
# Leave empty if PostgreSQL is not running in Docker.
DOCKER_CONTAINER=

# Comma-separated list of tables that should never be modified.
# Example: users,audit_logs
BLOCKED_TABLES=

# Comma-separated list of sensitive columns to mask or protect.
# Example: users.password,users.ssn
SENSITIVE_COLUMNS=

# Run in read-only mode.
# true  = only read operations are allowed.
# false = read and write operations are allowed.
READONLY=false

# Application environment.
# Common values: development, production, test
NODE_ENV=development

# Command execution rate limiting (POST /api/tools/:name and /api/migrations/apply).
# Requests per window; leave empty or 0 to disable.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=60000

# Failed-authentication throttling (only applies when DASHBOARD_TOKEN is set).
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Set only when the API is served behind a reverse proxy so client IPs are
# resolved per request. Accepts true, a hop count (e.g. 1), or a subnet or name
# (e.g. loopback, 10.0.0.0/8). Leave empty when clients connect directly.
TRUST_PROXY=