# ------------------------------------------------------------------
# Environment Variables Example
# ------------------------------------------------------------------
# 1. Copy this file to `.env`
# 2. Replace the example values with your own.
# 3. Never commit your real `.env` file.
#
# This file contains placeholder values only and is safe to commit.
# ------------------------------------------------------------------

# Base URL used by the frontend to communicate with the backend API.
# Keep "/api" when the frontend and Express API are served together.
# Use a full URL only when the API is hosted separately.
VITE_API_BASE=/api

# Optional auth token sent as a Bearer token on every API request.
# Set it to the same value as the API's DASHBOARD_TOKEN when token auth is on.
VITE_DASHBOARD_TOKEN=
