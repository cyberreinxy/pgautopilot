# Copy this file to `.env` and replace the placeholder values.
# Never commit `.env` or any real credentials to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1

# Optional bearer token for API authentication.
# Leave empty when running locally without authentication.
DASHBOARD_TOKEN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://app.example.com,https://admin.example.com
# Leave empty for same-origin requests only.
CORS_ORIGINS=

# ─── Proxy ───────────────────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the API.
# Use 1 when behind Caddy, nginx, or Cloudflare.
TRUST_PROXY=0

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Maximum query execution time in milliseconds.
PG_STATEMENT_TIMEOUT_MS=10000

# ─── Safety ──────────────────────────────────────────────────────────────────
# The API is READ-ONLY by default. Set true to enable write tools.
# ALLOW_WRITES=true

# Set true to block every write operation, even with ALLOW_WRITES=true.
# READONLY=true

# Comma-separated table names writes are always refused for.
BLOCKED_TABLES=

# Comma-separated table names that warn but allow writes (defense in depth).
HIGH_RISK_TABLES=

# Extra column names to redact/strip on top of the built-in defaults
# (password, password_hash, token, secret, api_key, ssn, etc).
SENSITIVE_COLUMNS=

# Comma-separated tool names to disable entirely (e.g. db_delete_many,db_raw_query).
DISABLED_TOOLS=