# ---------------------------------------------------------------------------
# Single-database mode (default)
# ---------------------------------------------------------------------------
# PGAutoPilot reads DATABASE_URL from .env and connects to that one database.
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# For a remote managed database (Neon, Supabase, RDS, Render):
# DATABASE_URL=postgresql://user:password@remote-host.example.com:5432/mydb
# PGSSLMODE=require

# For a local database that still requires SSL:
# PGSSLMODE=prefer

# For a local database that must not use SSL even on a non-localhost host:
# PGSSLMODE=disable

# ---------------------------------------------------------------------------
# Multi-database mode (optional)
# ---------------------------------------------------------------------------
# If you have multiple databases, create a pgautopilot.json file alongside
# this .env. DATABASE_URL (above) becomes the "default" database, and you
# can add more connections in the config file:
#
#   pgautopilot.json:
#   {
#     "databases": {
#       "users_db": { "url": "postgresql://..." },
#       "analytics": { "url": "$ANALYTICS_DATABASE_URL" },
#       "staging":  { "url": "$STAGING_DATABASE_URL" }
#     },
#     "defaults": { "readonly": true }
#   }
#
# For databases referenced via env vars, define them here:
# ANALYTICS_DATABASE_URL=postgresql://user:pass@host:5432/analytics
# STAGING_DATABASE_URL=postgresql://user:pass@staging-host:5432/staging

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Connection pool & timeouts
# ---------------------------------------------------------------------------
PGPOOL_MAX=5
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
BACKUPS_DIR=./backups

# Name of the running Postgres container, used as a pg_dump fallback
# when the local pg_dump binary/client isn't available on the host.
DOCKER_CONTAINER=pgautopilot-db

# ---------------------------------------------------------------------------
# Safety & security
# ---------------------------------------------------------------------------
# Comma-separated table names writes are always refused for.
BLOCKED_TABLES=

# Comma-separated table names that warn but allow writes (defense in depth).
HIGH_RISK_TABLES=

# Extra column names to redact/strip on top of the built-in defaults
# (password, password_hash, token, secret, api_key, ssn, etc).
SENSITIVE_COLUMNS=

# The server is READ-ONLY by default. Set true to enable write tools.
# ALLOW_WRITES=true

# Comma-separated tool names to disable entirely (e.g. db_delete_many,db_raw_query).
DISABLED_TOOLS=

# Comma-separated PostgreSQL schemas to introspect (default: public).
PG_SCHEMAS=public

NODE_ENV=development
